---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/fine-calculator/" title="Traffic fine calculator" width="100%" height="1150" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the German fine calculator: free iframe code" description="Embed the German traffic fine calculator on your website for free with an iframe: one code to copy, no sign-up and no tracking, every calculation in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the fine calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up and no cost. The iframe loads the full calculator from this site; expat associations, driving schools and newsrooms are done in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link below the calculator stays visible, the calculator is not modified, and it is provided without warranty. Standard rates are maintained here, so your embed stays up to date automatically. For the German version, replace the address with <code>{`${SITE_URL}/embed/bussgeldrechner/`}</code>.</p>
    <p>Your readers' figures stay on their own device, since the fine is worked out by their browser, and the embedded frame drops no cookies at all. Any question can go through the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/fine-calculator/" title="Traffic fine calculator" width="100%" height="1150" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
