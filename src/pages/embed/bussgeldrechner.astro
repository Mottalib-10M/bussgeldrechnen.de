  <body class="bg-white p-2 text-navy-900">
    <BussgeldRechner client:load lang="de" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/de/bussgeldrechner/`} target="_blank" rel="noopener" class="underline">Bußgeldkatalog 2026 und Bußgeldrechner</a> · Rechnung nur im Browser</p>
