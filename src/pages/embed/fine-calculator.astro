---
/** Page embarquable (iframe) : Bußgeldrechner sans navigation. noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import BussgeldRechner from '../../components/calc/BussgeldRechner';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>German fine calculator 2026 – widget</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/fine-calculator/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <BussgeldRechner client:load lang="en" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/fine-calculator/`} target="_blank" rel="noopener" class="underline">German fine catalogue and calculator</a> · calculated in your browser only</p>
  </body>
</html>
